<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Parallel Execution Configuration
    - parallel="methods": Runs test methods in parallel (optimal for independent tests)
    - thread-count="3": Number of parallel threads (adjust based on machine resources)
    - data-provider-thread-count="2": Parallel data provider execution
-->
<suite name="Selenium TAF - Parallel Execution" parallel="methods" thread-count="3" data-provider-thread-count="2" verbose="1">

    <!-- Listeners for test execution -->
    <listeners>
        <listener class-name="com.taf.customListeners.TestNGListeners"/>
    </listeners>

    <!-- UI Tests - Run in parallel -->
    <test name="UI Tests - Parallel">
        <packages>
            <package name="com.taf.tests.ui"/>
        </packages>
    </test>

    <!-- API Tests - Run in parallel -->
    <test name="API Tests - Parallel">
        <packages>
            <package name="com.taf.tests.api"/>
        </packages>
    </test>

</suite>
