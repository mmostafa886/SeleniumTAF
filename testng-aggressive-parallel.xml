<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Aggressive Parallel Execution
    - parallel="methods": Maximum parallelism at method level
    - thread-count="5": Higher thread count for faster execution
    - REQUIRES: Strong machine resources and thread-safe implementation
    - BEST FOR: CI/CD pipelines with good resources
-->
<suite name="Selenium TAF - Aggressive Parallel" parallel="methods" thread-count="5" data-provider-thread-count="3" verbose="1">

    <!-- Listeners for test execution -->
    <listeners>
        <listener class-name="com.taf.customListeners.TestNGListeners"/>
    </listeners>

    <!-- All UI Tests -->
    <test name="All UI Tests">
        <packages>
            <package name="com.taf.tests.ui"/>
        </packages>
    </test>

    <!-- All API Tests -->
    <test name="All API Tests">
        <packages>
            <package name="com.taf.tests.api"/>
        </packages>
    </test>

</suite>
